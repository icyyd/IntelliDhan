# First account setup accepts this legacy administrator code. It also remains
# an emergency compatibility login; normal users sign in with email/password.
INTELLIDHAN_OWNER_TOKEN=replace-with-a-random-owner-token-at-least-24-characters
# Optional shared invite code for self-service account creation after the first
# administrator. Administrators can instead add accounts from the Account panel.
INTELLIDHAN_INVITE_CODE=replace-with-a-separate-random-invite-code
# Production HTTPS deployments must keep all session cookies Secure.
INTELLIDHAN_SECURE_COOKIE=true

# IntelliDhan never stores Robinhood credentials. These independent secrets
# protect its control plane and the Claude execution-agent endpoints.
AUTOTRADE_CONTROL_TOKEN=replace-with-a-long-random-control-token
AUTOTRADE_AGENT_TOKEN=replace-with-a-different-long-random-agent-token

# Optional override for the ignored runtime audit-state file.
AUTOTRADE_STATE_PATH=data/autotrade_state.json

# Operational state. PostgreSQL is deploy-durable and preferred in production.
# Without DATABASE_URL, IntelliDhan uses the ignored local SQLite path below.
# Mark a SQLite path deploy-durable only when it resides on a mounted volume.
INTELLIDHAN_STATE_DB=data/intellidhan-state.sqlite3
INTELLIDHAN_PERSISTENT_STATE=false
# Set this in production so readiness fails unless PostgreSQL/a mounted path is durable.
INTELLIDHAN_REQUIRE_DURABLE_STATE=false
# DATABASE_URL=postgresql://user:password@host:5432/intellidhan

# Optional on-demand AI research. Discovery and all deterministic ranking work
# without these values. The model may be changed as account availability evolves.
# OPENAI_API_KEY=replace-with-an-openai-api-key
OPENAI_SMART_SCAN_MODEL=gpt-5.6-luna

# Optional ChatGPT Workspace Agent dispatch. Add and publish an API channel in
# the ChatGPT agent builder, then copy its agtch_ identifier. Create a separate
# ChatGPT Admin access token scoped only to Workspace Agents. This token is not
# an OpenAI API key and must never be exposed to the browser.
# CHATGPT_WORKSPACE_AGENT_ID=agtch_replace-with-published-channel-id
# CHATGPT_WORKSPACE_AGENT_TOKEN=replace-with-workspace-agent-access-token
# Server-only, fine-grained GitHub token with read access to the private daily
# brief repository. Never expose this token to web/index.html or client code.
INTELLIDHAN_DAILY_BRIEF_GITHUB_TOKEN=
INTELLIDHAN_DAILY_BRIEF_REPOSITORY=icyyd/intellidhan-daily-brief
INTELLIDHAN_DAILY_BRIEF_REF=main
